          }
        ],
        "house_default": "no_end",
        "compile": "templates/ae.teae.end.yaml",
        "phrasings": "phrasings/ae.teae.end.yaml",
        "reading": "knowledge/ae.teae.end.md",
        "probes": ["ae_starts_after_emergence_window"],
