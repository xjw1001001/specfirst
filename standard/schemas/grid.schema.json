{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specfirst:schemas/0/grid",
  "title": "Display grid",
  "description": "The canonical display of one output (PLAN.md section 7.4): every cell has its text and the IDs of the ARD rows behind it. RTF, PDF and HTML are projections of it. A mock shell is the same grid with masks in place of numbers. Version 0; a change needs an ADR.",
  "type": "object",
  "required": ["schema", "output_id", "titles", "columns", "rows", "footnotes"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "specfirst/grid@0" },
    "output_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "titles": { "type": "array", "items": { "type": "string" } },
    "columns": {
      "description": "The data columns, left to right. Row labels are not a column.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/column" }
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "footnotes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "column": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^c[1-9][0-9]*$" },
        "label": { "type": "string" },
        "spanner": {
          "description": "A header that spans this column and its neighbours with the same value.",
          "type": "string"
        }
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "label", "cells"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^r[1-9][0-9]*$" },
        "label": { "type": "string" },
        "indent": { "type": "integer", "minimum": 0 },
        "section": { "type": "string" },
        "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" } }
      }
    },
    "cell": {
      "type": "object",
      "required": ["id", "column", "text", "ard"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "For example cell:Out14-3-1-1/r4/c2.",
          "type": "string",
          "pattern": "^cell:[!-~]+/r[1-9][0-9]*/c[1-9][0-9]*$"
        },
        "column": { "type": "string", "pattern": "^c[1-9][0-9]*$" },
        "text": { "type": "string" },
        "ard": {
          "description": "The ARD rows the text was made from. Empty for a cell that shows no computed value.",
          "type": "array",
          "items": { "type": "string", "pattern": "^ard:[!-~]+$" },
          "uniqueItems": true
        }
      }
    }
  }
}
